rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rules
    match /usernames/{username} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;

      match /prescriptions/{prescriptionId} {
        allow read, write: if true;
      }

      match /products/{productId} {
        allow read, write: if true;
      }

      match /schedules/{scheduleId} {
        allow read, write: if true;
      }
    }
  }
}
